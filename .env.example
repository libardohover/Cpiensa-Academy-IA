# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Clave de Gemini (https://aistudio.google.com/apikey).
# Sin clave, el AI Hub, el Tutor, Prompt Lab y Agent Studio responden en modo simulado.
GEMINI_API_KEY=

# URL pública de la plataforma (se usa en los enlaces de verificación de certificados).
# Si se deja vacía, se usa la dirección desde la que se accede (p. ej. http://localhost:3000).
APP_URL=

# Servidor
PORT=3000
HOST=0.0.0.0

# ─────────────────────────────────────────────────────────────
# Acceso, aprobación de cuentas y correo
# ─────────────────────────────────────────────────────────────

# Correo institucional que recibe y gestiona las solicitudes de ingreso.
APROBACIONES_CORREO=piensacorporacion@gmail.com

# Cuenta SuperAdmin que se crea la primera vez que arranca el servidor
# (vacío = el mismo APROBACIONES_CORREO). Recibe un enlace para establecer su contraseña.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_NOMBRE=Administración CPIENSA+

# Envío real de correos (Gmail). SMTP_PASS es una "contraseña de aplicación" de Google
# (Cuenta de Google → Seguridad → Verificación en dos pasos → Contraseñas de aplicaciones),
# NO la contraseña normal del correo. Sin estos datos, los correos se guardan en datos/correos/.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=piensacorporacion@gmail.com
SMTP_PASS=
SMTP_FROM=CPIENSA+ ACADEMY IA <piensacorporacion@gmail.com>

# Importante: los enlaces de los correos usan APP_URL. Si otros equipos van a usar la
# plataforma, pon aquí la dirección real (p. ej. http://192.168.1.20:3000 o https://academia.ejemplo.co).

# Selector de roles de demostración. Solo para el entorno de pruebas: déjalo en false en operación.
MODO_DEMO=false

# Duración de la sesión y cierre por inactividad
SESION_HORAS=8
SESION_INACTIVIDAD_MIN=60

# true solo si el servidor está detrás de un proxy inverso (Nginx, Caddy) que agrega X-Forwarded-For
TRUST_PROXY=false
